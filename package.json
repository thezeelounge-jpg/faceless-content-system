    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "trigger.dev": "^4.8.7",
    "typescript": "^5",
    "vitest": "^5.1.1"
