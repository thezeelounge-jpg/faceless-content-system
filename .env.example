# .env.example — copy to .env.local, then paste real values yourself in Notepad.
# Never paste real keys into any chat. .env.local is never committed to Git.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # starts with sb_publishable_ (older projects: "anon" key)
SUPABASE_SECRET_KEY=                    # starts with sb_secret_ (older projects: "service_role" key). Server only.

# Google login (turn on only after Google is set up in Supabase Auth > Providers)
NEXT_PUBLIC_GOOGLE_LOGIN=false

# Admins: comma-separated emails that can open /admin
ADMIN_EMAILS=

# Background jobs (Trigger.dev > your project > API keys > DEV secret key)
TRIGGER_SECRET_KEY=

# Claude API (Phase 2)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_PLANNER=claude-opus-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# HeyGen API v3 (Phase 3)
HEYGEN_API_KEY=
HEYGEN_WEBHOOK_SECRET=

# Speech-to-text (Phase 4)
STT_PROVIDER=
STT_API_KEY=

# Stock b-roll and email
PEXELS_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="Creator Tool <hello@yourdomain.com>"

# Payments (Phase 7)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LS_VARIANT_CREATOR=
LS_VARIANT_PRO=
LS_VARIANT_AGENCY=

# Support: digits with country code, for WhatsApp click-to-chat links
WHATSAPP_NUMBER=

# Money safety: keep these true on your laptop. Only "false" turns real calls on.
MOCK_HEYGEN=true
MOCK_STT=true
MOCK_CLAUDE=true
MOCK_PEXELS=true
